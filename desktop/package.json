{
  "name": "marketplace-scanner-desktop",
  "productName": "Marketplace Scanner",
  "version": "1.1.1",
  "description": "Desktop Facebook Marketplace deal scanner (Windows)",
  "main": "src/main.js",
  "author": "insomnia9379",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --publish never",
    "test": "node test/logic.test.js"
  },
  "devDependencies": {
    "electron": "31.7.7",
    "electron-builder": "24.13.3"
  },
  "dependencies": {
    "electron-store": "8.2.0"
  },
  "build": {
    "appId": "com.netapp.marketplacescanner.desktop",
    "productName": "Marketplace Scanner",
    "directories": { "output": "dist" },
    "files": ["src/**/*", "package.json"],
    "win": {
      "target": [
        { "target": "nsis", "arch": ["x64"] },
        { "target": "portable", "arch": ["x64"] }
      ],
      "artifactName": "MarketplaceScanner-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false
    },
    "portable": {
      "artifactName": "MarketplaceScanner-portable-${version}.${ext}"
    }
  }
}
